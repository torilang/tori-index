// The shoji showcase: every widget, themes, a custom font (Fira Sans), PNG images, scaling and input in any language.
// The window is resizable: panels flow into three, two or one column, and the overflow scrolls with the wheel.
//   cd preview && tori run main.tr
use shoji

const ACCENTS = "Torii|Sakura|Sea|Moss|Plum"

fn accent(k: i64) -> u32 {
    switch k {
        1 => return 0xE0608F
        2 => return 0x2F8FE0
        3 => return 0x4FA35B
        4 => return 0x8E5BD9
    }
    return 0xE8452C
}

fn main() {
    ui := shoji.open("shoji — showcase", 1100, 720)
    fira := shoji.load_font("FiraSans-Book.ttf")
    bold := shoji.load_font("FiraSans-Bold.ttf")
    if fira == null || bold == null {
        say("no FiraSans-*.ttf: run it from the preview folder")
        return
    }
    ui.set_font(fira)
    ui.set_bold(bold)
    logo := shoji.load_image("logo.png")
    photo := shoji.load_image("photo.png")
    play := shoji.load_image("play.png")
    heart := shoji.load_image("heart.png")
    star := shoji.load_image("star.png")
    gear := shoji.load_image("gear.png")
    builtin := shoji.default_font()

    var clicks = 0
    var likes = 0
    var hints = true
    var autosave = false
    var sound = true
    var quality = 1
    name := shoji.text_new("")
    var volume = 70
    var size = 18
    var lang = 0
    var acc = 0
    var theme = 0
    var tab = 0
    var frames = 0
    var last = ""

    for ui.frame() {
        frames += 1
        th := &ui.th
        // ---- layout for the window width
        W := ui.width()
        var cols = 1
        if W >= 1060 { cols = 3 } else if W >= 700 { cols = 2 }
        pw := (W - 20 * (cols + 1)) / cols
        ph := 590
        var top = 86
        var hx = W - 400
        var hy = 22
        if W < 760 {                     // narrow: the theme switches go under the logo
            hx = 20
            hy = 76
            top = 132
        }
        rows := (3 + cols - 1) / cols
        page := top + rows * (ph + 20) + 30
        ui.page_height(page)

        // ---- header
        ui.picture(logo, 24, 18, 44, 44, 0)
        ui.text_at(80, 14, "shoji", bold, 30, th.text)
        if W >= 980 { ui.text_at(82, 52, "user interfaces in Tori · Linux and Windows · vector fonts", null, 14, th.dim) }
        ui.area(hx, hy, draw_min(380, W - 40))
        ui.row(2)
        if ui.tabs(&theme, "Dark|Light") {
            if theme == 0 { ui.dark() } else { ui.light() }
            ui.accent(accent(acc))
        }
        if ui.dropdown(&acc, ACCENTS) { ui.accent(accent(acc)) }
        ui.end()

        // ---- buttons and checkboxes
        ui.panel("Buttons", px(0, cols, pw), py(0, cols, top, ph), pw, ph)
        ui.row(2)
        if ui.primary("Press me") {
            clicks += 1
            last = "primary button"
        }
        if ui.button("Reset") {
            clicks = 0
            likes = 0
            last = "reset"
        }
        ui.label(shoji.cat("Pressed: ", shoji.num(clicks)))
        ui.note("Image buttons")
        ui.row(4)
        if ui.image_button(play, "") { last = "play" }
        if ui.image_button(heart, "") {
            likes += 1
            last = "like"
        }
        if ui.image_button(star, "") { last = "star" }
        ui.label(shoji.cat("likes: ", shoji.num(likes)))
        if ui.image_button(gear, "Settings") { last = "settings" }
        ui.separator()
        ui.checkbox("Show hints", &hints)
        ui.toggle("Autosave", &autosave)
        ui.toggle("Sound", &sound)
        ui.separator()
        ui.note("Quality")
        ui.radio("Low", &quality, 0)
        ui.radio("Medium", &quality, 1)
        ui.radio("High", &quality, 2)
        ui.end()

        // ---- input
        ui.panel("Input", px(1, cols, pw), py(1, cols, top, ph), pw, ph)
        ui.note("Name — in any language and any layout")
        ui.input(name, "What's your name?")
        if name.n > 0 { ui.label(shoji.cat(shoji.cat("Hello, ", name.get()), "!")) } else { ui.label("Ελληνικά · ქართული · 日本語 · 한국어") }
        ui.note(shoji.cat(shoji.cat("Scale ", shoji.num(ui.scale())), " % · Ctrl + wheel"))
        ui.row(3)
        if ui.button("A−") { ui.set_zoom(ui.zoom - 10) }
        if ui.button("100 %") { ui.set_zoom(100) }
        if ui.button("A+") { ui.set_zoom(ui.zoom + 10) }
        ui.note("Volume")
        ui.slider(&volume, 0, 100)
        ui.note("Text size on the right")
        ui.slider(&size, 12, 32)
        ui.note("Loading")
        ui.progress((ui.time() / 30) % 101, 100)
        ui.note("Language")
        ui.dropdown(&lang, "English|Русский|Українська|Deutsch|日本語|中文")
        ui.note("Last action")
        if last.span == 0 { ui.label("—") } else { ui.label(last) }
        if hints { ui.note("Hint: the frame is redrawn every time") }
        ui.end()

        // ---- text and images
        ui.panel("Text and images", px(2, cols, pw), py(2, cols, top, ph), pw, ph)
        ui.tabs(&tab, "Image|Fonts|About")
        if tab == 0 {
            ui.image(photo, 190, 18)
            ui.note("PNG 480×300: scaled, 18 px corners")
            ui.row(3)
            ui.image(photo, 70, 8)
            ui.image(photo, 70, 35)
            ui.image(photo, 70, 0)
            ui.note("radii 8, 35 and 0")
        } else if tab == 1 {
            ui.styled("Fira Sans Book", fira, size, th.text)
            ui.styled("Fira Sans Bold", bold, size, th.text)
            ui.styled("Built-in Noto Sans", builtin, size, th.text)
            ui.styled("The quick brown fox jumps over the lazy dog", fira, size * 3 / 4, th.dim)
            ui.styled("The quick brown fox — 0123456789", builtin, size * 3 / 4, th.dim)
            ui.styled("Aa Gg Жж", bold, size * 2, th.accent)
            ui.styled("漢字 · かな · 한글 — from system fonts", null, size * 3 / 4, th.dim)
        } else {
            ui.para("shoji is a UI toolkit for Tori. Everything is drawn in software straight into the window's pixels: rectangles with rounded corners and soft shadows, anti-aliased polygons, TrueType fonts and PNG images.")
            ui.space(6)
            ui.para("The widgets are immediate mode: every frame the window is described anew, and a button answers right away whether it was pressed. There are no callbacks — and no need for them.")
            ui.space(6)
            ui.note("nest install shoji")
        }
        ui.end()

        // ---- status bar
        sy := page - 26
        ui.text_at(24, sy, shoji.cat(shoji.cat("mouse ", shoji.num(ui.mouse_x())), shoji.cat(", ", shoji.num(ui.mouse_y()))), null, 13, th.dim)
        ui.text_at(180, sy, shoji.cat("frame ", shoji.num(frames)), null, 13, th.dim)
        ui.text_at(300, sy, shoji.cat(shoji.cat("window ", shoji.num(W)), shoji.cat("×", shoji.num(ui.height()))), null, 13, th.dim)
    }
}

// the k-th panel: x and y with cols columns of width pw
fn px(k: i64, cols: i64, pw: i64) -> i64 { return 20 + (k % cols) * (pw + 20) }
fn py(k: i64, cols: i64, top: i64, ph: i64) -> i64 { return top + (k / cols) * (ph + 20) }

fn draw_min(a: i64, b: i64) -> i64 {
    if a < b { return a }
    return b
}
