// Витрина shoji: все виджеты, темы, свой шрифт (Fira Sans), картинки PNG, масштаб и ввод на любом языке.
// Окно растягивается: панели встают в три, две или одну колонку, лишнее листается колесом.
//   cd preview && tori run main.tr
use shoji

const ACCENTS = "Тории|Сакура|Море|Мох|Слива"

fn accent(k: i64) -> u32 {
    switch k {
        1 => return 0xE0608F
        2 => return 0x2F8FE0
        3 => return 0x4FA35B
        4 => return 0x8E5BD9
    }
    return 0xE8452C
}

fn main() {
    ui := shoji.open("shoji — витрина", 1100, 720)
    fira := shoji.load_font("FiraSans-Book.ttf")
    bold := shoji.load_font("FiraSans-Bold.ttf")
    if fira == null || bold == null {
        say("нет FiraSans-*.ttf: запускай из папки preview")
        return
    }
    ui.set_font(fira)
    ui.set_bold(bold)
    logo := shoji.load_image("logo.png")
    photo := shoji.load_image("photo.png")
    play := shoji.load_image("play.png")
    heart := shoji.load_image("heart.png")
    star := shoji.load_image("star.png")
    gear := shoji.load_image("gear.png")
    builtin := shoji.default_font()

    var clicks = 0
    var likes = 0
    var hints = true
    var autosave = false
    var sound = true
    var quality = 1
    name := shoji.text_new("")
    var volume = 70
    var size = 18
    var lang = 0
    var acc = 0
    var theme = 0
    var tab = 0
    var frames = 0
    var last = ""

    for ui.frame() {
        frames += 1
        th := &ui.th
        // ---- раскладка под ширину окна
        W := ui.width()
        var cols = 1
        if W >= 1060 { cols = 3 } else if W >= 700 { cols = 2 }
        pw := (W - 20 * (cols + 1)) / cols
        ph := 590
        var top = 86
        var hx = W - 400
        var hy = 22
        if W < 760 {                     // узко: переключатели темы — под логотипом
            hx = 20
            hy = 76
            top = 132
        }
        rows := (3 + cols - 1) / cols
        page := top + rows * (ph + 20) + 30
        ui.page_height(page)

        // ---- шапка
        ui.picture(logo, 24, 18, 44, 44, 0)
        ui.text_at(80, 14, "shoji", bold, 30, th.text)
        if W >= 980 { ui.text_at(82, 52, "интерфейсы на Tori · Linux и Windows · векторные шрифты", null, 14, th.dim) }
        ui.area(hx, hy, draw_min(380, W - 40))
        ui.row(2)
        if ui.tabs(&theme, "Тёмная|Светлая") {
            if theme == 0 { ui.dark() } else { ui.light() }
            ui.accent(accent(acc))
        }
        if ui.dropdown(&acc, ACCENTS) { ui.accent(accent(acc)) }
        ui.end()

        // ---- кнопки и флажки
        ui.panel("Кнопки", px(0, cols, pw), py(0, cols, top, ph), pw, ph)
        ui.row(2)
        if ui.primary("Нажми меня") {
            clicks += 1
            last = "основная кнопка"
        }
        if ui.button("Сбросить") {
            clicks = 0
            likes = 0
            last = "сброс"
        }
        ui.label(shoji.cat("Нажато: ", shoji.num(clicks)))
        ui.note("Кнопки-картинки")
        ui.row(4)
        if ui.image_button(play, "") { last = "играть" }
        if ui.image_button(heart, "") {
            likes += 1
            last = "лайк"
        }
        if ui.image_button(star, "") { last = "звезда" }
        ui.label(shoji.cat("лайков: ", shoji.num(likes)))
        if ui.image_button(gear, "Настройки") { last = "настройки" }
        ui.separator()
        ui.checkbox("Показывать подсказки", &hints)
        ui.toggle("Автосохранение", &autosave)
        ui.toggle("Звук", &sound)
        ui.separator()
        ui.note("Качество")
        ui.radio("Низкое", &quality, 0)
        ui.radio("Среднее", &quality, 1)
        ui.radio("Высокое", &quality, 2)
        ui.end()

        // ---- ввод
        ui.panel("Ввод", px(1, cols, pw), py(1, cols, top, ph), pw, ph)
        ui.note("Имя — на любом языке и в любой раскладке")
        ui.input(name, "Как тебя зовут?")
        if name.n > 0 { ui.label(shoji.cat(shoji.cat("Привет, ", name.get()), "!")) } else { ui.label("Ελληνικά · ქართული · 日本語 · 한국어") }
        ui.note(shoji.cat(shoji.cat("Масштаб ", shoji.num(ui.scale())), " % · Ctrl + колесо"))
        ui.row(3)
        if ui.button("A−") { ui.set_zoom(ui.zoom - 10) }
        if ui.button("100 %") { ui.set_zoom(100) }
        if ui.button("A+") { ui.set_zoom(ui.zoom + 10) }
        ui.note("Громкость")
        ui.slider(&volume, 0, 100)
        ui.note("Размер текста справа")
        ui.slider(&size, 12, 32)
        ui.note("Загрузка")
        ui.progress((ui.time() / 30) % 101, 100)
        ui.note("Язык")
        ui.dropdown(&lang, "Русский|English|Українська|Deutsch|日本語|中文")
        ui.note("Последнее действие")
        if last.span == 0 { ui.label("—") } else { ui.label(last) }
        if hints { ui.note("Подсказка: кадр рисуется заново") }
        ui.end()

        // ---- текст и картинки
        ui.panel("Текст и картинки", px(2, cols, pw), py(2, cols, top, ph), pw, ph)
        ui.tabs(&tab, "Картинка|Шрифты|О пакете")
        if tab == 0 {
            ui.image(photo, 190, 18)
            ui.note("PNG 480×300: масштаб и скругление 18 px")
            ui.row(3)
            ui.image(photo, 70, 8)
            ui.image(photo, 70, 35)
            ui.image(photo, 70, 0)
            ui.note("радиусы 8, 35 и 0")
        } else if tab == 1 {
            ui.styled("Fira Sans Book", fira, size, th.text)
            ui.styled("Fira Sans Bold", bold, size, th.text)
            ui.styled("Встроенный Noto Sans", builtin, size, th.text)
            ui.styled("Съешь же ещё этих мягких булок", fira, size * 3 / 4, th.dim)
            ui.styled("The quick brown fox — 0123456789", builtin, size * 3 / 4, th.dim)
            ui.styled("Аа Жж Яя", bold, size * 2, th.accent)
            ui.styled("漢字 · かな · 한글 — из шрифтов системы", null, size * 3 / 4, th.dim)
        } else {
            ui.para("shoji — пакет интерфейсов для Tori. Всё рисуется программно в пиксели окна: прямоугольники со скруглениями и мягкими тенями, сглаженные многоугольники, шрифты TrueType и картинки PNG.")
            ui.space(6)
            ui.para("Виджеты в стиле immediate mode: каждый кадр окно описывается заново, а кнопка сразу отвечает, нажали ли её. Колбэков нет — они и не нужны.")
            ui.space(6)
            ui.note("nest install shoji")
        }
        ui.end()

        // ---- строка состояния
        sy := page - 26
        ui.text_at(24, sy, shoji.cat(shoji.cat("мышь ", shoji.num(ui.mouse_x())), shoji.cat(", ", shoji.num(ui.mouse_y()))), null, 13, th.dim)
        ui.text_at(180, sy, shoji.cat("кадр ", shoji.num(frames)), null, 13, th.dim)
        ui.text_at(300, sy, shoji.cat(shoji.cat("окно ", shoji.num(W)), shoji.cat("×", shoji.num(ui.height()))), null, 13, th.dim)
    }
}

// k-я панель: x и y при cols колонках шириной pw
fn px(k: i64, cols: i64, pw: i64) -> i64 { return 20 + (k % cols) * (pw + 20) }
fn py(k: i64, cols: i64, top: i64, ph: i64) -> i64 { return top + (k / cols) * (ph + 20) }

fn draw_min(a: i64, b: i64) -> i64 {
    if a < b { return a }
    return b
}
