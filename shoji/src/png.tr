// png — a PNG decoder: inflate (zlib), row filters, all color types, depth 1–16, no interlacing.
use sys
use draw

pub var err: str                         // why it failed (after null)

// ---- inflate
struct Bits {
    d: *u8
    n: i64
    p: i64                               // byte
    bit: i64                             // bit in it
    out: *u8
    on: i64
    cap: i64
    bad: bool
}

struct Huff {
    count: [16]i64
    sym: [320]i64
}

fn bits(b: *Bits, k: i64) -> i64 {
    var v = 0
    for i in 0..k {
        if b.p >= b.n {
            b.bad = true
            return 0
        }
        v = v | (((@as(i64, b.d[b.p]) >> b.bit) & 1) << i)
        b.bit += 1
        if b.bit == 8 {
            b.bit = 0
            b.p += 1
        }
    }
    return v
}

fn build(h: *Huff, lens: *i64, n: i64) {
    for i in 0..16 { h.count[i] = 0 }
    for i in 0..n { h.count[lens[i]] += 1 }
    h.count[0] = 0
    var offs: [16]i64
    offs[1] = 0
    for i in 1..15 { offs[i + 1] = offs[i] + h.count[i] }
    for i in 0..n {
        if lens[i] != 0 {
            h.sym[offs[lens[i]]] = i
            offs[lens[i]] += 1
        }
    }
}

fn decode(b: *Bits, h: *Huff) -> i64 {
    var code = 0
    var first = 0
    var index = 0
    for len in 1..16 {
        code = code | bits(b, 1)
        count := h.count[len]
        if code - count < first { return h.sym[index + (code - first)] }
        index += count
        first += count
        first = first << 1
        code = code << 1
    }
    b.bad = true
    return 0
}

fn emit(b: *Bits, v: i64) {
    if b.on >= b.cap {
        b.bad = true
        return
    }
    b.out[b.on] = @as(u8, v)
    b.on += 1
}

var lbase: [29]i64
var lext: [29]i64
var dbase: [30]i64
var dext: [30]i64

fn tables() {
    if lbase[0] != 0 { return }
    var v = 3
    for i in 0..28 {
        var e = 0
        if i >= 8 { e = (i - 4) / 4 }
        lbase[i] = v
        lext[i] = e
        v += 1 << e
    }
    lbase[28] = 258
    lext[28] = 0
    var d = 1
    for i in 0..30 {
        var e = 0
        if i >= 4 { e = (i - 2) / 2 }
        dbase[i] = d
        dext[i] = e
        d += 1 << e
    }
}

fn block(b: *Bits, lh: *Huff, dh: *Huff) {
    for !b.bad {
        s := decode(b, lh)
        if s < 256 {
            emit(b, s)
        } else if s == 256 {
            return
        } else {
            k := s - 257
            if k >= 29 {
                b.bad = true
                return
            }
            len := lbase[k] + bits(b, lext[k])
            ds := decode(b, dh)
            if ds >= 30 {
                b.bad = true
                return
            }
            dist := dbase[ds] + bits(b, dext[ds])
            if dist > b.on {
                b.bad = true
                return
            }
            for i in 0..len { emit(b, @as(i64, b.out[b.on - dist])) }
        }
    }
}

fn inflate(b: *Bits) {
    tables()
    lh := @as(*Huff, sys.alloc(@size(Huff)))
    dh := @as(*Huff, sys.alloc(@size(Huff)))
    var lens: [320]i64
    for !b.bad {
        last := bits(b, 1)
        typ := bits(b, 2)
        if typ == 0 {
            if b.bit != 0 {
                b.bit = 0
                b.p += 1
            }
            if b.p + 4 > b.n {
                b.bad = true
                return
            }
            len := @as(i64, b.d[b.p]) | (@as(i64, b.d[b.p + 1]) << 8)
            b.p += 4
            for i in 0..len {
                if b.p >= b.n {
                    b.bad = true
                    return
                }
                emit(b, @as(i64, b.d[b.p]))
                b.p += 1
            }
        } else if typ == 1 {
            for i in 0..288 {
                var l = 8
                if i >= 144 && i < 256 { l = 9 }
                if i >= 256 && i < 280 { l = 7 }
                lens[i] = l
            }
            build(lh, &lens[0], 288)
            for i in 0..30 { lens[i] = 5 }
            build(dh, &lens[0], 30)
            block(b, lh, dh)
        } else if typ == 2 {
            nlen := bits(b, 5) + 257
            ndist := bits(b, 5) + 1
            ncode := bits(b, 4) + 4
            var cl: [19]i64
            for i in 0..19 { cl[i] = 0 }
            for i in 0..ncode { cl[ord(i)] = bits(b, 3) }
            ch := @as(*Huff, sys.alloc(@size(Huff)))
            build(ch, &cl[0], 19)
            var i = 0
            for i < nlen + ndist && !b.bad {
                s := decode(b, ch)
                if s < 16 {
                    lens[i] = s
                    i += 1
                } else {
                    var rep = 0
                    var v = 0
                    if s == 16 {
                        if i == 0 {
                            b.bad = true
                            return
                        }
                        v = lens[i - 1]
                        rep = 3 + bits(b, 2)
                    } else if s == 17 {
                        rep = 3 + bits(b, 3)
                    } else {
                        rep = 11 + bits(b, 7)
                    }
                    for k in 0..rep {
                        if i < 320 {
                            lens[i] = v
                            i += 1
                        }
                    }
                }
            }
            build(lh, &lens[0], nlen)
            build(dh, &lens[nlen], ndist)
            block(b, lh, dh)
        } else {
            b.bad = true
        }
        if last == 1 { return }
    }
}

fn ord(i: i64) -> i64 {                  // the order of code length code lengths
    switch i {
        0 => return 16
        1 => return 17
        2 => return 18
        3 => return 0
        4 => return 8
        5 => return 7
        6 => return 9
        7 => return 6
        8 => return 10
        9 => return 5
        10 => return 11
        11 => return 4
        12 => return 12
        13 => return 3
        14 => return 13
        15 => return 2
        16 => return 14
        17 => return 1
    }
    return 15
}

// ---- PNG
fn be32(d: *u8, o: i64) -> i64 {
    return (@as(i64, d[o]) << 24) | (@as(i64, d[o + 1]) << 16) | (@as(i64, d[o + 2]) << 8) | @as(i64, d[o + 3])
}

fn paeth(a: i64, b: i64, c: i64) -> i64 {
    p := a + b - c
    var pa = p - a
    var pb = p - b
    var pc = p - c
    if pa < 0 { pa = -pa }
    if pb < 0 { pb = -pb }
    if pc < 0 { pc = -pc }
    if pa <= pb && pa <= pc { return a }
    if pb <= pc { return b }
    return c
}

fn fail(why: str) -> *draw.Image {
    err = why
    return null
}

// PNG file bytes -> an image | null (the reason is in err)
pub fn decode_png(data: str) -> *draw.Image {
    d := data.ptr
    n := @as(i64, data.span)
    if n < 33 || d[1] != 'P' || d[2] != 'N' || d[3] != 'G' { return fail("not a PNG") }
    var w = 0
    var h = 0
    var depth = 0
    var ctype = 0
    var plte = 0
    var nplte = 0
    var trns = 0
    var ntrns = 0
    zd := sys.alloc(n)                   // all IDAT chunks back to back
    var zn = 0
    var p = 8
    for p + 8 <= n {
        len := be32(d, p)
        typ := be32(d, p + 4)
        body := p + 8
        if len < 0 || body + len > n { return fail("truncated file") }
        switch typ {
            0x49484452 => {              // IHDR
                w = be32(d, body)
                h = be32(d, body + 4)
                depth = @as(i64, d[body + 8])
                ctype = @as(i64, d[body + 9])
                if d[body + 12] != 0 { return fail("interlaced PNG is not supported") }
            }
            0x504C5445 => {              // PLTE
                plte = body
                nplte = len / 3
            }
            0x74524E53 => {              // tRNS
                trns = body
                ntrns = len
            }
            0x49444154 => {              // IDAT
                for i in 0..len { zd[zn + i] = d[body + i] }
                zn += len
            }
        }
        if typ == 0x49454E44 { break }
        p = body + len + 4
    }
    if w <= 0 || h <= 0 || w > 16384 || h > 16384 { return fail("invalid size") }
    var ch = 1
    switch ctype {
        2 => ch = 3
        4 => ch = 2
        6 => ch = 4
    }
    bpp := ch * depth                    // bits per pixel
    stride := (w * bpp + 7) / 8
    bytes := imax(1, bpp / 8)
    b := @as(*Bits, sys.alloc(@size(Bits)))
    b.d = zd + 2                         // without the zlib header
    b.n = zn - 2
    b.cap = (stride + 1) * h
    b.out = sys.alloc(b.cap + 16)
    inflate(b)
    if b.bad || b.on < b.cap { return fail("corrupted data") }
    raw := b.out
    for y in 0..h {                      // row filters
        row := raw + y * (stride + 1)
        ft := @as(i64, row[0])
        cur := row + 1
        var prev: *u8 = null
        if y > 0 { prev = raw + (y - 1) * (stride + 1) + 1 }
        for x in 0..stride {
            var a = 0
            var up = 0
            var c = 0
            if x >= bytes { a = @as(i64, cur[x - bytes]) }
            if prev != null {
                up = @as(i64, prev[x])
                if x >= bytes { c = @as(i64, prev[x - bytes]) }
            }
            var v = @as(i64, cur[x])
            switch ft {
                1 => v += a
                2 => v += up
                3 => v += (a + up) / 2
                4 => v += paeth(a, up, c)
            }
            cur[x] = @as(u8, v & 255)
        }
    }
    img := @as(*draw.Image, sys.alloc(@size(draw.Image)))
    img.w = w
    img.h = h
    img.px = @as(*u32, sys.alloc(w * h * 4))
    for y in 0..h {
        row := raw + y * (stride + 1) + 1
        for x in 0..w {
            var r = 0
            var g = 0
            var bl = 0
            var al = 255
            if ctype == 3 {
                k := sample(row, x, depth)
                if k < nplte {
                    r = @as(i64, d[plte + k * 3])
                    g = @as(i64, d[plte + k * 3 + 1])
                    bl = @as(i64, d[plte + k * 3 + 2])
                }
                if k < ntrns { al = @as(i64, d[trns + k]) }
            } else {
                r = level(row, x * ch, depth)
                if ch >= 3 {
                    g = level(row, x * ch + 1, depth)
                    bl = level(row, x * ch + 2, depth)
                } else {
                    g = r
                    bl = r
                }
                if ch == 2 { al = level(row, x * ch + 1, depth) }
                if ch == 4 { al = level(row, x * ch + 3, depth) }
            }
            img.px[y * w + x] = @as(u32, (al << 24) | (r << 16) | (g << 8) | bl)
        }
    }
    return img
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

// the k-th value of a row with depth bits per value
fn sample(row: *u8, k: i64, depth: i64) -> i64 {
    if depth == 8 { return @as(i64, row[k]) }
    if depth == 16 { return @as(i64, row[k * 2]) }
    bit := k * depth
    v := @as(i64, row[bit / 8])
    return (v >> (8 - depth - bit % 8)) & ((1 << depth) - 1)
}

// the same, scaled to 0..255
fn level(row: *u8, k: i64, depth: i64) -> i64 {
    if depth == 16 { return (((@as(i64, row[k * 2]) << 8) | @as(i64, row[k * 2 + 1])) * 255 + 32767) / 65535 }
    v := sample(row, k, depth)
    switch depth {
        1 => return v * 255
        2 => return v * 85
        4 => return v * 17
    }
    return v
}
