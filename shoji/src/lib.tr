// shoji — user interfaces in Tori: panels, buttons, checkboxes, toggles, sliders, dropdowns, text fields,
// tabs, text in vector fonts, PNG images, rounded corners and shadows. Linux and Windows.
//
// It's immediate mode: every frame the program "describes" the window anew, and a widget answers
// right away what was done to it. No callbacks.
//
// Coordinates and sizes are in logical pixels: on screen they are multiplied by the scale
// (system DPI × the user's zoom: Ctrl + wheel, Ctrl + = / - / 0). The window is resizable:
//
//     ui := shoji.open("Hello", 640, 480)
//     var n = 0
//     for ui.frame() {
//         ui.panel("Counter", 20, 20, 300, 200)
//         if ui.button("More") { n += 1 }
//         ui.label(shoji.num(n))
//         ui.end()
//     }
use sys
use draw
use font
use png

pub struct Theme {
    bg: u32                              // window background
    panel: u32
    border: u32
    text: u32
    dim: u32                             // secondary text
    accent: u32
    on_accent: u32                       // text on the accent
    button: u32
    hover: u32
    press: u32
    field: u32                           // text fields, slider tracks
    radius: i64                          // sizes are in logical pixels
    size: i64                            // text size
    title: i64                           // heading size
    pad: i64                             // padding inside a panel
    gap: i64                             // between widgets
    h: i64                               // height of buttons and fields
}

// a rectangle
pub struct Rect {
    x: i64
    y: i64
    w: i64
    h: i64
}

struct Lay {
    x: i64
    y: i64
    w: i64
    cols: i64
    col: i64
    rowh: i64
    cx0: i64
    cy0: i64
    cx1: i64
    cy1: i64
}

// a string for a text field
pub struct Text {
    b: [256]u8
    n: i64
}

pub struct Ui {
    win: *Window
    c: *draw.Canvas
    th: Theme
    font: *font.Font
    bold: *font.Font
    mx: i64                              // mouse
    my: i64
    down: bool
    pressed: bool                        // pressed during this frame
    released: bool                       // released during this frame
    wheel: i64
    id: i64                              // widget number within the frame
    active: i64                          // held down by the mouse
    focus: i64                           // the text field with the cursor
    cur: i64                             // the cursor in it (byte)
    anchor: i64                          // the other end of the selection (byte); == cur — nothing selected
    seldrag: i64                         // the field being selected with the mouse | 0
    ishift: i64                          // how far the focused field's text is scrolled left (px)
    blocked: bool                        // the mouse is over a popup list
    lay: Lay
    st: [16]Lay
    sp: i64
    pop: i64                             // the open list: id | 0
    pop_r: Rect
    pop_items: str
    pop_v: *i64
    pop_pick: i64                        // picked during this frame: index | -1
    started: bool
    t0: i64
    m: Theme                             // the theme in screen pixels (th × scale)
    sc: i64                              // scale, %: DPI / 96 × zoom
    zoom: i64                            // the user's zoom, % (100 — as designed)
    dpi: i64                             // screen DPI (96 — 100 %)
    page: i64                            // page height for scrolling (logical px) | 0
    scroll: i64                          // how far the page is scrolled
    sb_grab: i64                         // the scrollbar is being dragged: mouse offset in it | -1
}

// ---- a ring buffer for short strings: num, cat
var ring: *u8
var rp: i64

fn take(n: i64) -> *u8 {
    if ring == null { ring = sys.alloc(0x10000) }
    if rp + n > 0x10000 { rp = 0 }
    p := ring + rp
    rp += n
    return p
}

// number -> string (lives for a few frames)
pub fn num(v: i64) -> str {
    var tmp: [24]u8
    var n = 0
    var x = v
    if x < 0 { x = -x }
    for {
        tmp[n] = @as(u8, '0' + x % 10)
        n += 1
        x = x / 10
        if x == 0 { break }
    }
    if v < 0 {
        tmp[n] = '-'
        n += 1
    }
    p := take(n)
    for i in 0..n { p[i] = tmp[n - 1 - i] }
    return p[0..n]
}

// joins two strings (lives for a few frames)
pub fn cat(a: str, b: str) -> str {
    na := @as(i64, a.span)
    nb := @as(i64, b.span)
    p := take(na + nb)
    for i in 0..na { p[i] = a[i] }
    for i in 0..nb { p[na + i] = b[i] }
    return p[0..na + nb]
}

pub fn text_new(s: str) -> *Text {
    t := @as(*Text, sys.alloc(@size(Text)))
    t.set(s)
    return t
}

pub fn Text.set(t: *Text, s: str) {
    var n = @as(i64, s.span)
    if n > 255 { n = 255 }
    for i in 0..n { t.b[i] = s[i] }
    t.n = n
}

pub fn Text.get(t: *Text) -> str { return t.b[0..t.n] }

// remove bytes [a, b)
pub fn Text.cut(t: *Text, a: i64, b: i64) {
    k := b - a
    for j in b..t.n { t.b[j - k] = t.b[j] }
    t.n -= k
}

// insert n bytes of s at byte at, as many whole characters as fit -> how many bytes went in
pub fn Text.ins(t: *Text, at: i64, s: *u8, n: i64) -> i64 {
    var m = n
    if t.n + m > 255 {
        m = 255 - t.n
        for m > 0 && (s[m] & 0xC0) == 0x80 { m -= 1 }
    }
    if m <= 0 { return 0 }
    var j = t.n - 1
    for j >= at {
        t.b[j + m] = t.b[j]
        j -= 1
    }
    for i in 0..m { t.b[at + i] = s[i] }
    t.n += m
    return m
}

// ---- fonts and images
// a .ttf, .otf or .ttc font from a file | null
pub fn load_font(path: str) -> *font.Font { return font.load_ttf(sys.map_file(path)) }

// a fallback font: characters missing from the main one are taken from it
pub fn fallback(f: *font.Font) { font.add_fallback(f) }

// look up missing characters in system fonts (yes by default)
pub fn system_fonts(on: bool) { font.no_system = !on }

// the built-in font (Noto Sans)
pub fn default_font() -> *font.Font { return font.builtin() }

// a .png image from a file | null (why — image_error())
pub fn load_image(path: str) -> *draw.Image {
    d := sys.read_file(path)
    if d.span == 0 {
        png.err = "no such file"
        return null
    }
    return png.decode_png(d)
}

pub fn image_error() -> str { return png.err }

// ---- the window
// a window of w×h logical pixels (at 150 % scale it's 1.5 times larger), resizable
pub fn open(title: str, w: i64, h: i64) -> *Ui {
    dpi := window_dpi()
    win := window(title, w * dpi / 96, h * dpi / 96)
    win.resize = true
    return attach(win)
}

pub fn attach(win: *Window) -> *Ui {
    u := @as(*Ui, sys.alloc(@size(Ui)))
    u.win = win
    u.c = draw.canvas(win.px, win.w, win.h)
    u.font = font.builtin()
    u.bold = u.font
    u.dark()
    u.t0 = sys.ms()
    u.dpi = window_dpi()
    u.zoom = 100
    u.sb_grab = -1
    u.rescale()
    return u
}

// ---- scale: logical pixels -> screen pixels
fn Ui.rescale(u: *Ui) {
    if u.zoom < 50 { u.zoom = 50 }
    if u.zoom > 400 { u.zoom = 400 }
    u.sc = u.dpi * u.zoom / 96
    if u.sc < 25 { u.sc = 25 }
    u.m = u.th
    u.m.radius = u.dp(u.th.radius)
    u.m.size = u.dp(u.th.size)
    u.m.title = u.dp(u.th.title)
    u.m.pad = u.dp(u.th.pad)
    u.m.gap = u.dp(u.th.gap)
    u.m.h = u.dp(u.th.h)
}

fn Ui.dp(u: *Ui, v: i64) -> i64 {
    if v < 0 { return -((-v * u.sc + 50) / 100) }
    return (v * u.sc + 50) / 100
}
fn Ui.lg(u: *Ui, v: i64) -> i64 { return v * 100 / u.sc }       // screen pixels -> logical
fn Ui.ox(u: *Ui, x: i64) -> i64 { return u.dp(x) }
fn Ui.oy(u: *Ui, y: i64) -> i64 { return u.dp(y - u.scroll) }
fn Ui.box(u: *Ui, x: i64, y: i64, w: i64, h: i64) -> Rect {   // logical rectangle -> screen rectangle
    x0 := u.ox(x)
    y0 := u.oy(y)
    return Rect { x: x0, y: y0, w: u.ox(x + w) - x0, h: u.oy(y + h) - y0 }
}
fn Ui.fk(u: *Ui) -> f32 { return @as(f32, u.sc) / 100.0 }

pub fn Ui.px(u: *Ui, v: i64) -> i64 { return u.dp(v) }          // for drawing on canvas()
pub fn Ui.scale(u: *Ui) -> i64 { return u.sc }                    // scale, %
pub fn Ui.set_zoom(u: *Ui, pct: i64) {
    u.zoom = pct
    u.rescale()
}
pub fn Ui.width(u: *Ui) -> i64 { return u.lg(u.win.w) }           // the window in logical pixels
pub fn Ui.height(u: *Ui) -> i64 { return u.lg(u.win.h) }

// a page of height h: if it's taller than the window, it's scrolled with the wheel and the bar on the right
pub fn Ui.page_height(u: *Ui, h: i64) { u.page = h }

pub fn Ui.dark(u: *Ui) {
    u.th = Theme { bg: 0x16171C, panel: 0x1F2128, border: 0x30333C, text: 0xE8E9ED, dim: 0x8B8F9A,
        accent: 0xE8452C, on_accent: 0xFFFFFF, button: 0x2B2E37, hover: 0x353945, press: 0x23252C,
        field: 0x131418, radius: 10, size: 16, title: 22, pad: 16, gap: 10, h: 36 }
}

pub fn Ui.light(u: *Ui) {
    acc := u.th.accent
    u.th = Theme { bg: 0xE9ECF1, panel: 0xFFFFFF, border: 0xD7DAE1, text: 0x1D1F24, dim: 0x6B7080,
        accent: 0xE8452C, on_accent: 0xFFFFFF, button: 0xFFFFFF, hover: 0xE4E6EC, press: 0xD8DBE2,
        field: 0xF3F4F7, radius: 10, size: 16, title: 22, pad: 16, gap: 10, h: 36 }
    if acc != 0 { u.th.accent = acc }
}

pub fn Ui.accent(u: *Ui, col: u32) { u.th.accent = col }
pub fn Ui.set_font(u: *Ui, f: *font.Font) {
    if f != null { u.font = f }
}
pub fn Ui.set_bold(u: *Ui, f: *font.Font) {
    if f != null { u.bold = f }
}
pub fn Ui.canvas(u: *Ui) -> *draw.Canvas { return u.c }
pub fn Ui.mouse_x(u: *Ui) -> i64 { return u.lg(u.mx) }
pub fn Ui.mouse_y(u: *Ui) -> i64 { return u.lg(u.my) + u.scroll }
pub fn Ui.key(u: *Ui, k: i64) -> bool { return k >= 0 && k < 256 && u.win.hit[k] }
pub fn Ui.held(u: *Ui, k: i64) -> bool { return k >= 0 && k < 256 && u.win.down[k] }
pub fn Ui.time(u: *Ui) -> i64 { return sys.ms() - u.t0 }    // ms since the window opened

// one frame: finish drawing the last one, show it, process input, start a new one. false — the window was closed
pub fn Ui.frame(u: *Ui) -> bool {
    if u.started { u.finish() }
    frame()
    if !u.win.open { return false }
    u.begin()
    return true
}

// start of a frame (if you drive the windows yourself through frame())
pub fn Ui.begin(u: *Ui) {
    u.started = true
    w := u.win
    u.c.px = w.px                        // the window may have been resized
    u.c.w = w.w
    u.c.h = w.h
    u.mx = w.mx
    u.my = w.my
    d := (w.mb & MOUSE_LEFT) != 0
    u.pressed = d && !u.down
    u.released = !d && u.down
    u.down = d
    u.wheel = w.wheel
    u.id = 0
    u.pop_pick = -1
    if w.down[KEY_CTRL] {                // zoom
        var z = u.zoom
        if w.hit['='] { z += 10 }
        if w.hit['-'] { z -= 10 }
        if w.hit['0'] { z = 100 }
        z += u.wheel * 10
        u.wheel = 0
        if z != u.zoom {
            u.pop = 0
            u.zoom = z
        }
    }
    u.rescale()                          // and the theme may have changed
    u.blocked = u.pop != 0 && inside(u.pop_r, u.mx, u.my)
    if u.pop != 0 && u.pressed && u.blocked {    // a pick in the open list
        u.pop_pick = (u.my - u.pop_r.y - u.dp(4)) / u.m.h
    }
    u.scrolling()
    draw.noclip(u.c)
    draw.fill(u.c, 0, 0, u.c.w, u.c.h, u.th.bg)
    u.sp = 0
    u.lay = Lay { x: u.m.pad, y: u.oy(u.th.pad), w: u.c.w - 2 * u.m.pad, cols: 1, cx1: u.c.w, cy1: u.c.h }
}

// page scrolling: wheel, PgUp/PgDn, the bar on the right
fn Ui.max_scroll(u: *Ui) -> i64 { return draw.imax(0, u.page - u.lg(u.win.h)) }

fn Ui.thumb(u: *Ui) -> Rect {
    h := u.win.h
    var th = h * u.lg(h) / draw.imax(1, u.page)
    if th < u.dp(32) { th = u.dp(32) }
    ms := draw.imax(1, u.max_scroll())
    return Rect { x: u.win.w - u.dp(12), y: (h - th) * u.scroll / ms, w: u.dp(12), h: th }
}

fn Ui.scrolling(u: *Ui) {
    ms := u.max_scroll()
    old := u.scroll
    if ms > 0 {
        if u.wheel != 0 && !u.blocked { u.scroll -= u.wheel * 48 }
        if u.focus == 0 {
            if u.win.hit[KEY_PGDN] { u.scroll += u.lg(u.win.h) * 9 / 10 }
            if u.win.hit[KEY_PGUP] { u.scroll -= u.lg(u.win.h) * 9 / 10 }
        }
        on := u.mx >= u.win.w - u.dp(12) && !u.blocked
        if on && u.pressed {
            t := u.thumb()
            if u.my >= t.y && u.my < t.y + t.h { u.sb_grab = u.my - t.y } else { u.sb_grab = t.h / 2 }
        }
        if u.sb_grab >= 0 {
            t := u.thumb()
            room := draw.imax(1, u.win.h - t.h)
            u.scroll = (u.my - u.sb_grab) * ms / room
            if !u.down { u.sb_grab = -1 }
        }
        if on || u.sb_grab >= 0 { u.blocked = true }
    } else {
        u.sb_grab = -1
    }
    if u.scroll > ms { u.scroll = ms }
    if u.scroll < 0 { u.scroll = 0 }
    if u.scroll != old { u.pop = 0 }
}

// end of a frame: the popup list on top of everything
pub fn Ui.finish(u: *Ui) {
    if u.max_scroll() > 0 {
        draw.noclip(u.c)
        t := u.thumb()
        var a = 110
        if u.sb_grab >= 0 || u.mx >= u.win.w - u.dp(12) { a = 200 }
        draw.rrect(u.c, t.x + u.dp(4), t.y + u.dp(2), u.dp(5), t.h - u.dp(4), u.dp(3), u.th.dim, a)
    }
    if u.pop != 0 { u.draw_popup() }
    if u.released { u.active = 0 }
    u.started = false
}

fn inside(r: Rect, x: i64, y: i64) -> bool { return x >= r.x && y >= r.y && x < r.x + r.w && y < r.y + r.h }

// ---- layout: panels, rows, spacing
fn Ui.push(u: *Ui) {
    if u.sp < 16 {
        u.st[u.sp] = u.lay
        u.sp += 1
    }
}

// the next place for your own widget of height h (logical pixels, as is the result)
pub fn Ui.next(u: *Ui, h: i64) -> Rect {
    r := u.slot(u.dp(h))
    return Rect { x: u.lg(r.x), y: u.lg(r.y) + u.scroll, w: u.lg(r.w), h: h }
}

// the same in screen pixels
fn Ui.slot(u: *Ui, h: i64) -> Rect {
    l := &u.lay
    if l.cols > 1 {
        cw := (l.w - (l.cols - 1) * u.m.gap) / l.cols
        r := Rect { x: l.x + l.col * (cw + u.m.gap), y: l.y, w: cw, h: h }
        if h > l.rowh { l.rowh = h }
        l.col += 1
        if l.col == l.cols {
            l.y += l.rowh + u.m.gap
            l.cols = 1
            l.col = 0
            l.rowh = 0
        }
        return r
    }
    r := Rect { x: l.x, y: l.y, w: l.w, h: h }
    l.y += h + u.m.gap
    return r
}

// the next n widgets go in a row, sharing the width equally
pub fn Ui.row(u: *Ui, n: i64) {
    l := &u.lay
    if l.cols > 1 && l.col > 0 { l.y += l.rowh + u.m.gap }
    l.cols = n
    l.col = 0
    l.rowh = 0
}

pub fn Ui.space(u: *Ui, h: i64) { u.lay.y += u.dp(h) }

// a panel with a title (title may be ""); inside — a column of widgets until end()
pub fn Ui.panel(u: *Ui, title: str, lx: i64, ly: i64, lw: i64, lh: i64) {
    th := &u.m
    b := u.box(lx, ly, lw, lh)
    x := b.x
    y := b.y
    w := b.w
    h := b.h
    draw.shadow(u.c, x, y, w, h, th.radius, u.dp(10))
    draw.rrect_box(u.c, x, y, w, h, th.radius + u.dp(4), th.panel, th.border, 1)
    u.push()
    var ty = y + th.pad
    if title.span != 0 {
        font.text(u.c, u.bold, th.title, x + th.pad, ty, th.text, 255, title)
        ty += font.line_h(u.bold, th.title) + th.gap
    }
    u.lay = Lay { x: x + th.pad, y: ty, w: w - 2 * th.pad, cols: 1, cx0: u.c.cx0, cy0: u.c.cy0, cx1: u.c.cx1, cy1: u.c.cy1 }
    draw.clip(u.c, x + 1, y + 1, w - 2, h - 2)
}

// a column without a background: widgets from (x, y) with width w until end()
pub fn Ui.area(u: *Ui, x: i64, y: i64, w: i64) {
    u.push()
    b := u.box(x, y, w, 0)
    u.lay = Lay { x: b.x, y: b.y, w: b.w, cols: 1, cx0: u.c.cx0, cy0: u.c.cy0, cx1: u.c.cx1, cy1: u.c.cy1 }
}

pub fn Ui.end(u: *Ui) {
    if u.sp == 0 { return }
    l := u.lay
    u.c.cx0 = l.cx0
    u.c.cy0 = l.cy0
    u.c.cx1 = l.cx1
    u.c.cy1 = l.cy1
    u.sp -= 1
    u.lay = u.st[u.sp]
}

// ---- widget state
fn Ui.hot(u: *Ui, r: Rect) -> bool { return !u.blocked && inside(r, u.mx, u.my) }

// whether r was clicked (id — the widget number)
fn Ui.click(u: *Ui, id: i64, r: Rect) -> bool {
    hot := u.hot(r)
    if hot && u.pressed { u.active = id }
    return u.released && u.active == id && hot
}

fn Ui.fill_for(u: *Ui, id: i64, r: Rect, base: u32) -> u32 {
    if u.active == id && u.hot(r) { return draw.mix(base, 0, 40) }
    if u.hot(r) { return draw.mix(base, 0xFFFFFF, 22) }
    return base
}

fn Ui.label_at(u: *Ui, r: Rect, s: str, col: u32, center: bool) {
    lh := font.line_h(u.font, u.m.size)
    ty := r.y + (r.h - lh) / 2
    var tx = r.x
    if center { tx = r.x + (r.w - font.width(u.font, u.m.size, s)) / 2 }
    font.text(u.c, u.font, u.m.size, tx, ty, col, 255, s)
}

// ---- widgets
pub fn Ui.label(u: *Ui, s: str) {
    r := u.slot(font.line_h(u.font, u.m.size))
    font.text(u.c, u.font, u.m.size, r.x, r.y, u.m.text, 255, s)
}

// a dimmed small caption
pub fn Ui.note(u: *Ui, s: str) {
    sz := u.m.size * 7 / 8
    r := u.slot(font.line_h(u.font, sz))
    font.text(u.c, u.font, sz, r.x, r.y, u.m.dim, 255, s)
}

pub fn Ui.heading(u: *Ui, s: str) {
    r := u.slot(font.line_h(u.bold, u.m.title))
    font.text(u.c, u.bold, u.m.title, r.x, r.y, u.m.text, 255, s)
}

// text of any size and color in font f (null — the main one)
pub fn Ui.styled(u: *Ui, s: str, f: *font.Font, size: i64, col: u32) {
    var ff = f
    if ff == null { ff = u.font }
    sz := u.dp(size)
    r := u.slot(font.line_h(ff, sz))
    font.text(u.c, ff, sz, r.x, r.y, col, 255, s)
}

// a paragraph with word wrapping
pub fn Ui.para(u: *Ui, s: str) {
    lh := font.line_h(u.font, u.m.size)
    var w = u.lay.w
    if u.lay.cols > 1 { w = (u.lay.w - (u.lay.cols - 1) * u.m.gap) / u.lay.cols }
    n := wrap(u, s, w, 0, 0, false)
    r := u.slot(n * lh)
    wrap(u, s, r.w, r.x, r.y, true)
}

fn wrap(u: *Ui, s: str, w: i64, x: i64, y: i64, paint: bool) -> i64 {
    lh := font.line_h(u.font, u.m.size)
    var lines = 0
    var i = 0
    n := @as(i64, s.span)
    for i < n {
        var k = font.fit(u.font, u.m.size, s[i..n], w)
        if k <= 0 { k = font.ulen(s[i]) }
        var end = i + k
        if end < n && s[end] != ' ' && s[end] != 10 {   // back to a space
            var b = end
            for b > i && s[b] != ' ' { b -= 1 }
            if b > i { end = b }
        }
        for j in i..end {
            if s[j] == 10 {
                end = j
                break
            }
        }
        if paint { font.text(u.c, u.font, u.m.size, x, y + lines * lh, u.m.text, 255, s[i..end]) }
        lines += 1
        i = end
        if i < n && (s[i] == ' ' || s[i] == 10) { i += 1 }
    }
    if lines == 0 { lines = 1 }
    return lines
}

pub fn Ui.separator(u: *Ui) {
    r := u.slot(1)
    draw.fill(u.c, r.x, r.y, r.w, 1, u.m.border)
}

pub fn Ui.button(u: *Ui, s: str) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h)
    hit := u.click(id, r)
    draw.rrect_box(u.c, r.x, r.y, r.w, r.h, u.m.radius, u.fill_for(id, r, u.m.button), u.m.border, 1)
    u.label_at(r, s, u.m.text, true)
    return hit
}

// the main button — in the accent color
pub fn Ui.primary(u: *Ui, s: str) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h)
    hit := u.click(id, r)
    draw.rrect(u.c, r.x, r.y, r.w, r.h, u.m.radius, u.fill_for(id, r, u.m.accent), 255)
    u.label_at(r, s, u.m.on_accent, true)
    return hit
}

// an image of height h (width by aspect ratio, no wider than the column), corners of radius rad
pub fn Ui.image(u: *Ui, img: *draw.Image, lh: i64, lrad: i64) {
    if img == null { return }
    h := u.dp(lh)
    rad := u.dp(lrad)
    r := u.slot(h)
    var w = img.w * h / img.h
    var hh = h
    if w > r.w {
        w = r.w
        hh = img.h * w / img.w
    }
    draw.image(u.c, img, r.x, r.y + (h - hh) / 2, w, hh, rad, 255)
}

// a button with an image; s == "" — just the image (a square button)
pub fn Ui.image_button(u: *Ui, img: *draw.Image, s: str) -> bool {
    u.id += 1
    id := u.id
    var r = u.slot(u.m.h)
    if s.span == 0 && r.w > r.h { r.w = r.h }
    hit := u.click(id, r)
    draw.rrect_box(u.c, r.x, r.y, r.w, r.h, u.m.radius, u.fill_for(id, r, u.m.button), u.m.border, 1)
    m7 := u.dp(7)
    isz := r.h - 2 * m7
    if s.span == 0 {
        draw.image(u.c, img, r.x + (r.w - isz) / 2, r.y + m7, isz, isz, 0, 255)
    } else {
        tw := font.width(u.font, u.m.size, s)
        x0 := r.x + (r.w - isz - u.dp(8) - tw) / 2
        draw.image(u.c, img, x0, r.y + m7, isz, isz, 0, 255)
        u.label_at(Rect { x: x0 + isz + u.dp(8), y: r.y, w: tw, h: r.h }, s, u.m.text, false)
    }
    return hit
}

fn Ui.check_mark(u: *Ui, x: i64, y: i64, s: i64, col: u32) {
    k := @as(f32, s) / 20.0
    fx := @as(f32, x)
    fy := @as(f32, y)
    draw.line(u.c, fx + 5.0 * k, fy + 10.5 * k, fx + 8.5 * k, fy + 14.0 * k, 2.4 * k, col)
    draw.line(u.c, fx + 7.6 * k, fy + 14.0 * k, fx + 15.0 * k, fy + 6.0 * k, 2.4 * k, col)
}

// a checkbox -> whether it changed
pub fn Ui.checkbox(u: *Ui, s: str, v: *bool) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h - u.dp(8))
    hit := u.click(id, r)
    if hit { *v = !*v }
    b := u.dp(20)
    by := r.y + (r.h - b) / 2
    if *v {
        draw.rrect(u.c, r.x, by, b, b, u.dp(5), u.fill_for(id, r, u.m.accent), 255)
        u.check_mark(r.x, by, b, u.m.on_accent)
    } else {
        draw.rrect_box(u.c, r.x, by, b, b, u.dp(5), u.fill_for(id, r, u.m.field), u.m.border, 1)
    }
    g := u.dp(10)
    u.label_at(Rect { x: r.x + b + g, y: r.y, w: r.w - b - g, h: r.h }, s, u.m.text, false)
    return hit
}

// a toggle -> whether it changed
pub fn Ui.toggle(u: *Ui, s: str, v: *bool) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h - u.dp(8))
    hit := u.click(id, r)
    if hit { *v = !*v }
    tw := u.dp(40)
    th := u.dp(22)
    m3 := u.dp(3)
    ty := r.y + (r.h - th) / 2
    var track = u.m.border
    var kx = r.x + m3
    if *v {
        track = u.m.accent
        kx = r.x + tw - th + m3
    }
    draw.rrect(u.c, r.x, ty, tw, th, th / 2, u.fill_for(id, r, track), 255)
    draw.rrect(u.c, kx, ty + m3, th - 2 * m3, th - 2 * m3, th, 0xFFFFFF, 255)
    g := u.dp(10)
    u.label_at(Rect { x: r.x + tw + g, y: r.y, w: r.w - tw - g, h: r.h }, s, u.m.text, false)
    return hit
}

// one of the options: *v becomes val -> whether it was picked just now
pub fn Ui.radio(u: *Ui, s: str, v: *i64, val: i64) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h - u.dp(8))
    hit := u.click(id, r)
    if hit { *v = val }
    b := u.dp(20)
    m6 := u.dp(6)
    by := r.y + (r.h - b) / 2
    if *v == val {
        draw.rrect(u.c, r.x, by, b, b, b, u.fill_for(id, r, u.m.accent), 255)
        draw.rrect(u.c, r.x + m6, by + m6, b - 2 * m6, b - 2 * m6, b, u.m.on_accent, 255)
    } else {
        draw.rrect_box(u.c, r.x, by, b, b, b, u.fill_for(id, r, u.m.field), u.m.border, 1)
    }
    g := u.dp(10)
    u.label_at(Rect { x: r.x + b + g, y: r.y, w: r.w - b - g, h: r.h }, s, u.m.text, false)
    return hit
}

// a slider lo..hi -> whether it changed
pub fn Ui.slider(u: *Ui, v: *i64, lo: i64, hi: i64) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h - u.dp(8))
    vw := u.dp(52)                       // the value on the right
    e := u.dp(10)                        // track margins
    tr := Rect { x: r.x, y: r.y, w: r.w - vw, h: r.h }
    if u.hot(tr) && u.pressed { u.active = id }
    old := *v
    if u.active == id && u.down && hi > lo && tr.w > 2 * e {
        var nv = lo + ((u.mx - tr.x - e) * (hi - lo) * 2 + (tr.w - 2 * e)) / ((tr.w - 2 * e) * 2)
        if nv < lo { nv = lo }
        if nv > hi { nv = hi }
        *v = nv
    }
    var k = 0
    if hi > lo { k = (*v - lo) * (tr.w - 2 * e) / (hi - lo) }
    cy := tr.y + tr.h / 2
    t3 := u.dp(3)
    draw.rrect(u.c, tr.x, cy - t3, tr.w, 2 * t3, t3, u.m.field, 255)
    draw.rrect(u.c, tr.x, cy - t3, k + e, 2 * t3, t3, u.m.accent, 255)
    var kn = u.dp(18)
    if u.active == id || u.hot(tr) { kn = u.dp(20) }
    draw.rrect(u.c, tr.x + k + e - kn / 2 - 1, cy - kn / 2 - 1, kn + 2, kn + 2, kn, u.m.border, 255)
    draw.rrect(u.c, tr.x + k + e - kn / 2, cy - kn / 2, kn, kn, kn, 0xFFFFFF, 255)
    vs := num(*v)
    u.label_at(Rect { x: r.x + r.w - vw + e, y: r.y, w: vw - e, h: r.h }, vs, u.m.dim, false)
    return *v != old
}

// a progress bar v out of max
pub fn Ui.progress(u: *Ui, v: i64, max: i64) {
    r := u.slot(u.dp(10))
    draw.rrect(u.c, r.x, r.y, r.w, r.h, r.h / 2, u.m.field, 255)
    if max > 0 && v > 0 {
        var w = r.w * v / max
        if w > r.w { w = r.w }
        draw.rrect(u.c, r.x, r.y, draw.imax(w, r.h), r.h, r.h / 2, u.m.accent, 255)
    }
}

// ---- lists: options separated by '|'
pub fn count(items: str) -> i64 {
    var n = 1
    for ch in items {
        if ch == '|' { n += 1 }
    }
    return n
}

pub fn item(items: str, k: i64) -> str {
    var i = 0
    var st = 0
    n := @as(i64, items.span)
    for j in 0..n + 1 {
        if j == n || items[j] == '|' {
            if i == k { return items[st..j] }
            i += 1
            st = j + 1
        }
    }
    return ""
}

fn Ui.chevron(u: *Ui, x: i64, y: i64, up: bool, col: u32) {
    fx := @as(f32, x)
    fy := @as(f32, y)
    k := u.fk()
    a := 5.0 * k
    b := 2.5 * k
    if up {
        draw.line(u.c, fx - a, fy + b, fx, fy - b, 2.0 * k, col)
        draw.line(u.c, fx, fy - b, fx + a, fy + b, 2.0 * k, col)
    } else {
        draw.line(u.c, fx - a, fy - b, fx, fy + b, 2.0 * k, col)
        draw.line(u.c, fx, fy + b, fx + a, fy - b, 2.0 * k, col)
    }
}

// a dropdown: *v — the index of the selected item -> whether one was picked just now
pub fn Ui.dropdown(u: *Ui, v: *i64, items: str) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h)
    n := count(items)
    var picked = false
    if u.pop == id {
        if u.pop_pick >= 0 && u.pop_pick < n {
            *v = u.pop_pick
            picked = true
            u.pop = 0
        } else if u.pressed && !inside(u.pop_r, u.mx, u.my) && !inside(r, u.mx, u.my) {
            u.pop = 0
        }
    }
    if u.click(id, r) {
        if u.pop == id {
            u.pop = 0
        } else {
            u.pop = id
            m4 := u.dp(4)
            var ph = n * u.m.h + 2 * m4
            var py = r.y + r.h + m4
            if py + ph > u.c.h && r.y - ph - m4 >= 0 { py = r.y - ph - m4 }
            u.pop_r = Rect { x: r.x, y: py, w: r.w, h: ph }
            u.pop_items = items
            u.pop_v = v
        }
    }
    open := u.pop == id
    var border = u.m.border
    if open { border = u.m.accent }
    draw.rrect_box(u.c, r.x, r.y, r.w, r.h, u.m.radius, u.fill_for(id, r, u.m.field), border, 1)
    u.label_at(Rect { x: r.x + u.dp(12), y: r.y, w: r.w - u.dp(40), h: r.h }, item(items, *v), u.m.text, false)
    u.chevron(r.x + r.w - u.dp(20), r.y + r.h / 2, open, u.m.dim)
    return picked
}

fn Ui.draw_popup(u: *Ui) {
    draw.noclip(u.c)
    r := u.pop_r
    draw.shadow(u.c, r.x, r.y, r.w, r.h, u.m.radius, u.dp(12))
    draw.rrect_box(u.c, r.x, r.y, r.w, r.h, u.m.radius, u.m.panel, u.m.border, 1)
    n := count(u.pop_items)
    m4 := u.dp(4)
    rr := draw.imax(0, u.m.radius - u.dp(3))
    for k in 0..n {
        ir := Rect { x: r.x + m4, y: r.y + m4 + k * u.m.h, w: r.w - 2 * m4, h: u.m.h }
        var col = u.m.text
        if k == *u.pop_v {
            draw.rrect(u.c, ir.x, ir.y, ir.w, ir.h, rr, u.m.accent, 255)
            col = u.m.on_accent
        } else if inside(ir, u.mx, u.my) {
            draw.rrect(u.c, ir.x, ir.y, ir.w, ir.h, rr, u.m.hover, 255)
        }
        u.label_at(Rect { x: ir.x + u.dp(10), y: ir.y, w: ir.w - u.dp(20), h: ir.h }, item(u.pop_items, k), col, false)
    }
}

// tabs: *v — the index of the open one -> whether it was switched
pub fn Ui.tabs(u: *Ui, v: *i64, items: str) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h)
    n := count(items)
    draw.rrect(u.c, r.x, r.y, r.w, r.h, u.m.radius, u.m.field, 255)
    var changed = false
    for k in 0..n {
        m3 := u.dp(3)
        tr := Rect { x: r.x + m3 + k * (r.w - 2 * m3) / n, y: r.y + m3, w: (r.w - 2 * m3) / n, h: r.h - 2 * m3 }
        if u.click(id * 64 + k + 0x100000, tr) && *v != k {
            *v = k
            changed = true
        }
        var col = u.m.dim
        if *v == k {
            draw.rrect_box(u.c, tr.x, tr.y, tr.w, tr.h, draw.imax(0, u.m.radius - u.dp(3)), u.m.button, u.m.border, 1)
            col = u.m.text
        } else if u.hot(tr) {
            col = u.m.text
        }
        u.label_at(tr, item(items, k), col, true)
    }
    return changed
}

// a text field: any language and layout, selection with the mouse and Shift,
// Ctrl+A / C / X / V (and Ctrl+Insert, Shift+Insert, Shift+Delete) -> whether the text changed
pub fn Ui.input(u: *Ui, t: *Text, hint: str) -> bool {
    u.id += 1
    id := u.id
    r := u.slot(u.m.h)
    pad := u.dp(12)
    hot := u.hot(r)
    w := u.win
    shift := w.down[KEY_SHIFT]
    ctrl := w.down[KEY_CTRL] && !w.down[KEY_ALT]          // AltGr on Windows is Ctrl + Alt: that's typing
    if u.pressed {
        if hot {
            if u.focus != id { u.ishift = 0 }
            u.focus = id
            u.cur = u.in_pos(t, r, pad)
            if !shift { u.anchor = u.cur }
            u.seldrag = id
        } else if u.focus == id {
            u.focus = 0
        }
    }
    focused := u.focus == id
    if u.seldrag == id {
        if !u.down || !focused { u.seldrag = 0 } else { u.cur = u.in_pos(t, r, pad) }
    }
    var changed = false
    if focused {
        if u.cur > t.n { u.cur = t.n }
        if u.anchor > t.n { u.anchor = t.n }
        lo := draw.imin(u.cur, u.anchor)
        hi := draw.imax(u.cur, u.anchor)
        if ctrl && w.hit['a'] {
            u.anchor = 0
            u.cur = t.n
        }
        if hi > lo && ((ctrl && (w.hit['c'] || w.hit['x'] || w.hit[KEY_INSERT])) || (shift && w.hit[KEY_DELETE])) {
            clip_set(t.get()[lo..hi])
        }
        if (ctrl && w.hit['x']) || (shift && !ctrl && w.hit[KEY_DELETE]) {
            if u.in_cut(t) { changed = true }
        } else if (ctrl && w.hit['v']) || (shift && !ctrl && w.hit[KEY_INSERT]) {
            c := clip_get()
            var b: [256]u8                   // one line: line breaks and tabs become spaces
            var n = 0
            for i in 0..@as(i64, c.span) {
                if n >= 255 { break }
                var ch = c[i]
                if ch == 10 || ch == 9 { ch = ' ' }
                if ch >= 32 && ch != 127 {
                    b[n] = ch
                    n += 1
                }
            }
            if u.in_cut(t) { changed = true }
            if u.in_put(t, &b[0], n) { changed = true }
        }
        tn := w.ntext                        // typed during the frame, UTF-8
        if tn > 0 {
            if u.in_cut(t) { changed = true }
            if u.in_put(t, &w.text[0], tn) { changed = true }
        }
        if w.hit[KEY_BACKSPACE] {
            if u.in_cut(t) {
                changed = true
            } else if u.cur > 0 {
                var k = 1
                for u.cur - k > 0 && (t.b[u.cur - k] & 0xC0) == 0x80 { k += 1 }
                t.cut(u.cur - k, u.cur)
                u.cur -= k
                changed = true
            }
        }
        if w.hit[KEY_DELETE] && !shift {
            if u.in_cut(t) {
                changed = true
            } else if u.cur < t.n {
                t.cut(u.cur, u.cur + font.ulen(t.b[u.cur]))
                changed = true
            }
        }
        var moved = false
        if w.hit[KEY_LEFT] {
            if !shift && u.cur != u.anchor {
                u.cur = draw.imin(u.cur, u.anchor)
            } else if u.cur > 0 {
                u.cur -= 1
                for u.cur > 0 && (t.b[u.cur] & 0xC0) == 0x80 { u.cur -= 1 }
            }
            moved = true
        }
        if w.hit[KEY_RIGHT] {
            if !shift && u.cur != u.anchor {
                u.cur = draw.imax(u.cur, u.anchor)
            } else if u.cur < t.n {
                u.cur += font.ulen(t.b[u.cur])
            }
            moved = true
        }
        if w.hit[KEY_HOME] {
            u.cur = 0
            moved = true
        }
        if w.hit[KEY_END] {
            u.cur = t.n
            moved = true
        }
        if moved && !shift { u.anchor = u.cur }
        if w.hit[KEY_ENTER] || w.hit[KEY_ESC] { u.focus = 0 }
    }
    var border = u.m.border
    if focused { border = u.m.accent }
    var bg = u.m.field
    if hot && !focused { bg = draw.mix(bg, 0xFFFFFF, 10) }
    draw.rrect_box(u.c, r.x, r.y, r.w, r.h, u.m.radius, bg, border, 1)
    if focused {
        m3 := u.dp(3)
        draw.rrect(u.c, r.x - m3, r.y - m3, r.w + 2 * m3, r.h + 2 * m3, u.m.radius + m3, u.m.accent, 40)
    }
    cx0 := u.c.cx0
    cy0 := u.c.cy0
    cx1 := u.c.cx1
    cy1 := u.c.cy1
    draw.clip(u.c, r.x + 2, r.y, r.w - 4, r.h)
    s := t.get()
    avail := r.w - 2 * pad
    var shiftx = 0
    tw := font.width(u.font, u.m.size, s[0..u.cur])
    if focused {                             // scroll the text so the cursor stays visible
        if tw - u.ishift > avail { u.ishift = tw - avail }
        if tw < u.ishift { u.ishift = tw }
        full := font.width(u.font, u.m.size, s)
        if u.ishift > 0 && full - u.ishift < avail { u.ishift = draw.imax(0, full - avail) }
        shiftx = u.ishift
    }
    sx := r.x + pad - shiftx
    lh := font.line_h(u.font, u.m.size)
    ty := r.y + (r.h - lh) / 2
    if focused && u.cur != u.anchor {
        lo := draw.imin(u.cur, u.anchor)
        hi := draw.imax(u.cur, u.anchor)
        x0 := sx + font.width(u.font, u.m.size, s[0..lo])
        x1 := sx + font.width(u.font, u.m.size, s[0..hi])
        draw.fill_a(u.c, x0, ty, x1 - x0, lh, u.m.accent, 90)
    }
    if t.n == 0 && !focused {
        font.text(u.c, u.font, u.m.size, sx, ty, u.m.dim, 255, hint)
    } else {
        font.text(u.c, u.font, u.m.size, sx, ty, u.m.text, 255, s)
    }
    if focused && (u.time() / 530) % 2 == 0 {
        cw := draw.imax(1, u.dp(2))
        draw.fill(u.c, sx + tw, ty + cw, cw, lh - 2 * cw, u.m.accent)
    }
    u.c.cx0 = cx0
    u.c.cy0 = cy0
    u.c.cx1 = cx1
    u.c.cy1 = cy1
    return changed
}

fn Ui.in_pos(u: *Ui, t: *Text, r: Rect, pad: i64) -> i64 {    // the byte under the mouse
    var x = u.mx - r.x - pad + u.dp(4)
    if u.focus == u.id { x += u.ishift }
    if x <= 0 { return 0 }
    return font.fit(u.font, u.m.size, t.get(), x)
}

fn Ui.in_cut(u: *Ui, t: *Text) -> bool {   // delete the selection -> whether there was one
    if u.cur == u.anchor { return false }
    lo := draw.imin(u.cur, u.anchor)
    t.cut(lo, draw.imax(u.cur, u.anchor))
    u.cur = lo
    u.anchor = lo
    return true
}

fn Ui.in_put(u: *Ui, t: *Text, s: *u8, n: i64) -> bool {   // insert at the cursor -> whether anything fit
    k := t.ins(u.cur, s, n)
    u.cur += k
    u.anchor = u.cur
    return k > 0
}

// ---- direct drawing (logical page coordinates)
pub fn Ui.rect(u: *Ui, x: i64, y: i64, w: i64, h: i64, rad: i64, col: u32) {
    b := u.box(x, y, w, h)
    draw.rrect(u.c, b.x, b.y, b.w, b.h, u.dp(rad), col, 255)
}

pub fn Ui.text_at(u: *Ui, x: i64, y: i64, s: str, f: *font.Font, size: i64, col: u32) -> i64 {
    var ff = f
    if ff == null { ff = u.font }
    return u.lg(font.text(u.c, ff, u.dp(size), u.ox(x), u.oy(y), col, 255, s))
}

pub fn Ui.picture(u: *Ui, img: *draw.Image, x: i64, y: i64, w: i64, h: i64, rad: i64) {
    b := u.box(x, y, w, h)
    draw.image(u.c, img, b.x, b.y, b.w, b.h, u.dp(rad), 255)
}

// string width in logical pixels
pub fn Ui.text_width(u: *Ui, f: *font.Font, size: i64, s: str) -> i64 {
    var ff = f
    if ff == null { ff = u.font }
    return u.lg(font.width(ff, u.dp(size), s))
}

pub fn text_width(f: *font.Font, size: i64, s: str) -> i64 { return font.width(f, size, s) }
