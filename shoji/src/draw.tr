// draw — drawing into window pixels: rectangles, anti-aliased rounded corners, masks,
// polygons, scaled images. Color is 0xRRGGBB, opacity is separate (0..255).
use sys

pub struct Canvas {
    px: *u32                             // w * h pixels 0xRRGGBB
    w: i64
    h: i64
    cx0: i64                             // clipping: only [cx0, cx1) × [cy0, cy1) is drawn
    cy0: i64
    cx1: i64
    cy1: i64
}

// an image: pixels 0xAARRGGBB
pub struct Image {
    w: i64
    h: i64
    px: *u32
}

pub fn canvas(px: *u32, w: i64, h: i64) -> *Canvas {
    c := @as(*Canvas, sys.alloc(@size(Canvas)))
    c.px = px
    c.w = w
    c.h = h
    noclip(c)
    return c
}

pub fn noclip(c: *Canvas) {
    c.cx0 = 0
    c.cy0 = 0
    c.cx1 = c.w
    c.cy1 = c.h
}

// clip to a rectangle (it never grows beyond the current one — use noclip for that)
pub fn clip(c: *Canvas, x: i64, y: i64, w: i64, h: i64) {
    c.cx0 = imax(c.cx0, x)
    c.cy0 = imax(c.cy0, y)
    c.cx1 = imin(c.cx1, x + w)
    c.cy1 = imin(c.cy1, y + h)
}

pub fn imin(a: i64, b: i64) -> i64 {
    if a < b { return a }
    return b
}

pub fn imax(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

pub fn rgb(r: i64, g: i64, b: i64) -> u32 { return @as(u32, ((r & 255) << 16) | ((g & 255) << 8) | (b & 255)) }

// a color mix: a/255 of s and the rest of d
pub fn mix(d: u32, s: u32, a: i64) -> u32 {
    if a >= 255 { return s }
    if a <= 0 { return d }
    dd := @as(i64, d)
    ss := @as(i64, s)
    ia := 255 - a
    r := d255(((ss >> 16) & 255) * a + ((dd >> 16) & 255) * ia)
    g := d255(((ss >> 8) & 255) * a + ((dd >> 8) & 255) * ia)
    b := d255((ss & 255) * a + (dd & 255) * ia)
    return @as(u32, (r << 16) | (g << 8) | b)
}

fn d255(x: i64) -> i64 {                 // x / 255 with rounding, without division
    v := x + 128
    return (v + (v >> 8)) >> 8
}

pub fn dot(c: *Canvas, x: i64, y: i64, col: u32, a: i64) {
    if x < c.cx0 || y < c.cy0 || x >= c.cx1 || y >= c.cy1 || a <= 0 { return }
    p := c.px + y * c.w + x
    *p = mix(*p, col, a)
}

fn span(c: *Canvas, x0: i64, x1: i64, y: i64, col: u32, a: i64) {
    if y < c.cy0 || y >= c.cy1 || a <= 0 { return }
    xa := imax(x0, c.cx0)
    xb := imin(x1, c.cx1)
    if xa >= xb { return }
    p := c.px + y * c.w
    if a >= 255 {
        c2 := (@as(i64, col) << 32) | @as(i64, col)
        q := @as(*i64, p + xa)
        n2 := (xb - xa) / 2
        for k in 0..n2 { q[k] = c2 }
        if ((xb - xa) & 1) != 0 { p[xb - 1] = col }
    } else {
        for x in xa..xb { p[x] = mix(p[x], col, a) }
    }
}

pub fn fill(c: *Canvas, x: i64, y: i64, w: i64, h: i64, col: u32) { fill_a(c, x, y, w, h, col, 255) }

pub fn fill_a(c: *Canvas, x: i64, y: i64, w: i64, h: i64, col: u32, a: i64) {
    for j in imax(y, c.cy0)..imin(y + h, c.cy1) { span(c, x, x + w, j, col, a) }
}

// ---- rounded corners: a quarter-circle mask of radius r (top-left corner), 4×4 anti-aliased
var corners: [257]*u8

fn corner(r: i64) -> *u8 {
    if r <= 256 && corners[r] != null { return corners[r] }
    m := sys.alloc(r * r)
    rr := r * r * 64                     // in 1/8 pixel: (8r)²
    for j in 0..r {
        for i in 0..r {
            var cov = 0
            for sy in 0..4 {
                for sx in 0..4 {
                    dx := (r * 8) - (i * 8 + sx * 2 + 1)
                    dy := (r * 8) - (j * 8 + sy * 2 + 1)
                    if dx * dx + dy * dy <= rr { cov += 1 }
                }
            }
            m[j * r + i] = @as(u8, (cov * 255 + 8) / 16)
        }
    }
    if r <= 256 { corners[r] = m }
    return m
}

// a rectangle with rounded corners of radius r; a — opacity
pub fn rrect(c: *Canvas, x: i64, y: i64, w: i64, h: i64, rad: i64, col: u32, a: i64) { rrect_rows(c, x, y, w, h, rad, col, a, 0, h) }

// rows j0..j1 of a rounded rectangle
fn rrect_rows(c: *Canvas, x: i64, y: i64, w: i64, h: i64, rad: i64, col: u32, a: i64, j0: i64, j1: i64) {
    if w <= 0 || h <= 0 { return }
    var r = imin(rad, imin(w / 2, h / 2))
    if r <= 0 {
        fill_a(c, x, y + j0, w, j1 - j0, col, a)
        return
    }
    m := corner(r)
    for j in imax(j0, c.cy0 - y)..imin(j1, c.cy1 - y) {
        yy := y + j
        if yy < c.cy0 || yy >= c.cy1 { continue }
        var cj = -1
        if j < r { cj = j }
        if j >= h - r { cj = h - 1 - j }
        if cj < 0 {
            span(c, x, x + w, yy, col, a)
        } else {
            row := m + cj * r
            for i in 0..r {
                k := @as(i64, row[i]) * a / 255
                dot(c, x + i, yy, col, k)
                dot(c, x + w - 1 - i, yy, col, k)
            }
            span(c, x + r, x + w - r, yy, col, a)
        }
    }
}

// a border of thickness t around a rounded rectangle, with fill inside
pub fn rrect_box(c: *Canvas, x: i64, y: i64, w: i64, h: i64, r: i64, fillc: u32, border: u32, t: i64) {
    if w <= 2 * t || h <= 2 * t {
        rrect(c, x, y, w, h, r, border, 255)
        return
    }
    rr := imax(imin(r, imin(w / 2, h / 2)), t)
    rrect_rows(c, x, y, w, h, r, border, 255, 0, rr)          // border: whole corners, only the edges on the sides
    rrect_rows(c, x, y, w, h, r, border, 255, h - rr, h)
    for j in rr..h - rr {
        span(c, x, x + t, y + j, border, 255)
        span(c, x + w - t, x + w, y + j, border, 255)
    }
    rrect(c, x + t, y + t, w - 2 * t, h - 2 * t, imax(0, r - t), fillc, 255)
}

// a soft shadow under a rectangle
// (drawn before the rectangle itself: no shadow is computed under it)
pub fn shadow(c: *Canvas, x: i64, y: i64, w: i64, h: i64, rad: i64, size: i64) {
    if size <= 0 || w <= 0 || h <= 0 { return }
    sy := y + size / 2                   // the shadow is a bit lower
    r := imin(rad, imin(w / 2, h / 2))
    big := (size + r) * (size + r)
    if big >= 4096 { return }
    s4 := size * 4
    for j in imax(sy - size, c.cy0)..imin(sy + h + size, c.cy1) {
        var qy = imax(sy + r - j, j - (sy + h - 1 - r))
        if qy < 0 { qy = 0 }
        var xa = x - size
        xb := x + w + size
        p := c.px + j * c.w
        under := j >= y + r && j < y + h - r                  // the row is covered by the rectangle in the middle
        var xi = imax(xa, c.cx0)
        for xi < imin(xb, c.cx1) {
            if under && xi >= x && xi < x + w {
                xi = x + w
                continue
            }
            var qx = imax(x + r - xi, xi - (x + w - 1 - r))
            if qx < 0 { qx = 0 }
            q2 := qx * qx + qy * qy
            if q2 < big {
                d4 := sq4(q2) - r * 4
                var al = 40
                if d4 > 0 { al = 40 * (s4 - d4) * (s4 - d4) / (s4 * s4) }
                if al > 0 { p[xi] = mix(p[xi], 0, al) }
            }
            xi += 1
        }
    }
}

var sqt: *i64                            // sqt[k] = 4·√k (for shadows)

fn sq4(k: i64) -> i64 {
    if sqt == null {
        sqt = @as(*i64, sys.alloc(4096 * 8))
        var v = 0
        for i in 0..4096 {
            for (v + 1) * (v + 1) <= i * 16 { v += 1 }
            sqt[i] = v
        }
    }
    return sqt[k]
}

// an opacity mask mw×mh (0..255) in color col at point (x, y)
pub fn mask(c: *Canvas, x: i64, y: i64, m: *u8, mw: i64, mh: i64, col: u32, a: i64) {
    for j in imax(0, c.cy0 - y)..imin(mh, c.cy1 - y) {
        row := m + j * mw
        p := c.px + (y + j) * c.w
        for i in imax(0, c.cx0 - x)..imin(mw, c.cx1 - x) {
            k := @as(i64, row[i])
            if k != 0 {
                if a < 255 { p[x + i] = mix(p[x + i], col, k * a / 255) } else { p[x + i] = mix(p[x + i], col, k) }
            }
        }
    }
}

// ---- an anti-aliasing rasterizer: area accumulation (as in font-rs).
// rs_begin(w, h) -> rs_line segments are drawn in mask coordinates -> rs_end(mask)
var ra: *f32                             // (w + 3) × (h + 1) accumulators
var rcap: i64
var rw: i64
var rh: i64

pub fn rs_begin(w: i64, h: i64) {
    n := (w + 3) * (h + 1)
    if n > rcap {
        rcap = imax(n, 0x40000)
        ra = @as(*f32, sys.mem(rcap * 4))
    } else {
        for i in 0..n { ra[i] = 0.0 }
    }
    rw = w
    rh = h
}

pub fn ffloor(x: f32) -> i64 {
    var i = @as(i64, x)
    if @as(f32, i) > x { i -= 1 }
    return i
}

pub fn fceil(x: f32) -> i64 {
    var i = @as(i64, x)
    if @as(f32, i) < x { i += 1 }
    return i
}

pub fn rs_line(ax: f32, ay: f32, bx: f32, by: f32) {
    if ay == by { return }
    var x0 = ax
    var y0 = ay
    var x1 = bx
    var y1 = by
    var dir: f32 = 1.0
    if ay > by {
        x0 = bx
        y0 = by
        x1 = ax
        y1 = ay
        dir = -1.0
    }
    dxdy := (x1 - x0) / (y1 - y0)
    var x = x0
    var ys = ffloor(y0)
    if y0 < 0.0 {
        x -= y0 * dxdy
        ys = 0
    }
    ye := imin(rh, fceil(y1))
    stride := rw + 3
    for y in ys..ye {
        ls := y * stride + 1
        var top = @as(f32, y)
        if y0 > top { top = y0 }
        var bot = @as(f32, y + 1)
        if y1 < bot { bot = y1 }
        dy := bot - top
        xn := x + dxdy * dy
        d := dy * dir
        var xa = x
        var xb = xn
        if xn < x {
            xa = xn
            xb = x
        }
        if xa < 0.0 { xa = 0.0 }
        if xb < 0.0 { xb = 0.0 }
        x0f := ffloor(xa)
        x0i := imin(x0f, rw)
        x1i := imin(fceil(xb), rw + 1)
        if x1i <= x0i + 1 {
            xmf := 0.5 * (xa + xb) - @as(f32, x0f)
            ra[ls + x0i] += d - d * xmf
            ra[ls + x0i + 1] += d * xmf
        } else {
            s := 1.0 / (xb - xa)
            fx0 := xa - @as(f32, x0f)
            a0 := 0.5 * s * (1.0 - fx0) * (1.0 - fx0)
            fx1 := xb - @as(f32, x1i) + 1.0
            am := 0.5 * s * fx1 * fx1
            ra[ls + x0i] += d * a0
            if x1i == x0i + 2 {
                ra[ls + x0i + 1] += d * (1.0 - a0 - am)
            } else {
                a1 := s * (1.5 - fx0)
                ra[ls + x0i + 1] += d * (a1 - a0)
                for xi in x0i + 2..x1i - 1 { ra[ls + xi] += d * s }
                a2 := a1 + @as(f32, x1i - x0i - 3) * s
                ra[ls + x1i - 1] += d * (1.0 - a2 - am)
            }
            ra[ls + x1i] += d * am
        }
        x = xn
    }
}

// a quadratic Bézier curve as segments
pub fn rs_quad(x0: f32, y0: f32, cx: f32, cy: f32, x1: f32, y1: f32) {
    var ddx = x0 - 2.0 * cx + x1
    var ddy = y0 - 2.0 * cy + y1
    if ddx < 0.0 { ddx = -ddx }
    if ddy < 0.0 { ddy = -ddy }
    var n = 1 + @as(i64, (ddx + ddy) * 0.7)
    if n > 24 { n = 24 }
    var px = x0
    var py = y0
    for i in 1..n + 1 {
        t := @as(f32, i) / @as(f32, n)
        u := 1.0 - t
        qx := u * u * x0 + 2.0 * u * t * cx + t * t * x1
        qy := u * u * y0 + 2.0 * u * t * cy + t * t * y1
        rs_line(px, py, qx, qy)
        px = qx
        py = qy
    }
}

// accumulators -> an rw×rh mask (0..255)
pub fn rs_end(out: *u8) {
    stride := rw + 3
    for y in 0..rh {
        var acc: f32 = 0.0
        row := ra + y * stride + 1
        for x in 0..rw {
            acc += row[x]
            var v = acc
            if v < 0.0 { v = -v }
            if v > 1.0 { v = 1.0 }
            out[y * rw + x] = @as(u8, @as(i64, v * 255.0 + 0.5))
        }
    }
}

// a filled anti-aliased polygon: n points (xs[i], ys[i]) in canvas pixels
pub fn poly(c: *Canvas, xs: *f32, ys: *f32, n: i64, col: u32, a: i64) {
    if n < 3 { return }
    var mnx = xs[0]
    var mxx = xs[0]
    var mny = ys[0]
    var mxy = ys[0]
    for i in 1..n {
        if xs[i] < mnx { mnx = xs[i] }
        if xs[i] > mxx { mxx = xs[i] }
        if ys[i] < mny { mny = ys[i] }
        if ys[i] > mxy { mxy = ys[i] }
    }
    bx := ffloor(mnx)
    by := ffloor(mny)
    bw := fceil(mxx) - bx + 1
    bh := fceil(mxy) - by + 1
    if bw <= 0 || bh <= 0 || bw > 4096 || bh > 4096 { return }
    rs_begin(bw, bh)
    for i in 0..n {
        j := (i + 1) % n
        rs_line(xs[i] - @as(f32, bx), ys[i] - @as(f32, by), xs[j] - @as(f32, bx), ys[j] - @as(f32, by))
    }
    m := sys.alloc(bw * bh)
    rs_end(m)
    mask(c, bx, by, m, bw, bh, col, a)
}

// a segment of thickness t (square ends)
pub fn line(c: *Canvas, x0: f32, y0: f32, x1: f32, y1: f32, t: f32, col: u32) {
    dx := x1 - x0
    dy := y1 - y0
    l := fsqrt(dx * dx + dy * dy)
    if l <= 0.0 { return }
    nx := -dy / l * t * 0.5
    ny := dx / l * t * 0.5
    var xs: [4]f32
    var ys: [4]f32
    xs[0] = x0 + nx
    ys[0] = y0 + ny
    xs[1] = x1 + nx
    ys[1] = y1 + ny
    xs[2] = x1 - nx
    ys[2] = y1 - ny
    xs[3] = x0 - nx
    ys[3] = y0 - ny
    poly(c, &xs[0], &ys[0], 4, col, 255)
}

pub fn fsqrt(v: f32) -> f32 {
    if v <= 0.0 { return 0.0 }
    var x = v
    if x < 1.0 { x = 1.0 }
    for i in 0..20 { x = 0.5 * (x + v / x) }
    return x
}

// an image into a w×h rectangle, scaled (bilinear), corners rounded with radius r; a — opacity
const NCACHE = 64
var ci_img: [NCACHE]*Image               // a cache of images at their final size
var ci_w: [NCACHE]i64
var ci_h: [NCACHE]i64
var ci_r: [NCACHE]i64
var ci_px: [NCACHE]*u32
var ci_next: i64

pub fn image(c: *Canvas, img: *Image, x: i64, y: i64, w: i64, h: i64, r: i64, a: i64) {
    if img == null || w <= 0 || h <= 0 || img.w <= 0 || img.h <= 0 || w > 8192 || h > 8192 { return }
    var k = -1
    for i in 0..NCACHE {
        if ci_img[i] == img && ci_w[i] == w && ci_h[i] == h && ci_r[i] == r { k = i }
    }
    if k < 0 {
        k = ci_next
        ci_next = (ci_next + 1) % NCACHE
        ci_img[k] = img
        ci_w[k] = w
        ci_h[k] = h
        ci_r[k] = r
        ci_px[k] = @as(*u32, sys.alloc(w * h * 4))
        var dst = Canvas { px: ci_px[k], w: w, h: h, cx1: w, cy1: h }
        scale(&dst, img, w, h, r)
    }
    src := ci_px[k]
    for j in imax(0, c.cy0 - y)..imin(h, c.cy1 - y) {
        p := c.px + (y + j) * c.w + x
        s := src + j * w
        for i in imax(0, c.cx0 - x)..imin(w, c.cx1 - x) {
            v := @as(i64, s[i])
            var al = (v >> 24) & 255
            if a < 255 { al = al * a / 255 }
            if al >= 255 {
                p[i] = @as(u32, v & 0xFFFFFF)
            } else if al > 0 {
                p[i] = mix(p[i], @as(u32, v & 0xFFFFFF), al)
            }
        }
    }
}

// an image in w×h pixels 0xAARRGGBB (bilinear, transparent corners)
fn scale(c: *Canvas, img: *Image, w: i64, h: i64, r: i64) {
    x := 0
    y := 0
    var rad = imin(r, imin(w / 2, h / 2))
    var m: *u8 = null
    if rad > 0 { m = corner(rad) }
    sx := (img.w << 16) / w
    sy := (img.h << 16) / h
    for j in imax(0, c.cy0 - y)..imin(h, c.cy1 - y) {
        fy := imax(0, j * sy + sy / 2 - 32768)
        y0 := imin(fy >> 16, img.h - 1)
        y1 := imin(y0 + 1, img.h - 1)
        wy := (fy >> 8) & 255
        var cj = -1
        if rad > 0 {
            if j < rad { cj = j }
            if j >= h - rad { cj = h - 1 - j }
        }
        p := c.px + (y + j) * c.w + x
        for i in imax(0, c.cx0 - x)..imin(w, c.cx1 - x) {
            fx := imax(0, i * sx + sx / 2 - 32768)
            x0 := imin(fx >> 16, img.w - 1)
            x1 := imin(x0 + 1, img.w - 1)
            wx := (fx >> 8) & 255
            s := bilerp(img.px[y0 * img.w + x0], img.px[y0 * img.w + x1], img.px[y1 * img.w + x0], img.px[y1 * img.w + x1], wx, wy)
            var al = (s >> 24) & 255
            if cj >= 0 {
                if i < rad { al = al * @as(i64, m[cj * rad + i]) / 255 }
                if i >= w - rad { al = al * @as(i64, m[cj * rad + (w - 1 - i)]) / 255 }
            }
            p[i] = @as(u32, (al << 24) | (s & 0xFFFFFF))
        }
    }
}

fn lerp8(a: i64, b: i64, t: i64) -> i64 { return a + (((b - a) * t) >> 8) }

fn bilerp(p00: u32, p10: u32, p01: u32, p11: u32, wx: i64, wy: i64) -> i64 {
    var out = 0
    for sh in 0..4 {
        k := sh * 8
        a := lerp8((@as(i64, p00) >> k) & 255, (@as(i64, p10) >> k) & 255, wx)
        b := lerp8((@as(i64, p01) >> k) & 255, (@as(i64, p11) >> k) & 255, wx)
        out = out | ((lerp8(a, b, wy) & 255) << k)
    }
    return out
}
