// math — integer math for Tori. use math -> math.pow(2, 10)
pub fn abs(x: i64) -> i64 {
    if x < 0 { return -x }
    return x
}

pub fn min(a: i64, b: i64) -> i64 {
    if a < b { return a }
    return b
}

pub fn max(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

pub fn clamp(x: i64, lo: i64, hi: i64) -> i64 { return max(lo, min(x, hi)) }

// x to the power n (n >= 0), by fast exponentiation
pub fn pow(x: i64, n: i64) -> i64 {
    var r = 1
    var b = x
    var k = n
    for k > 0 {
        if k & 1 == 1 { r *= b }
        b *= b
        k = k >> 1
    }
    return r
}

// the integer part of the square root (x >= 0)
pub fn isqrt(x: i64) -> i64 {
    if x < 2 { return x }
    var r = x
    var y = (r + 1) / 2
    for y < r {
        r = y
        y = (r + x / r) / 2
    }
    return r
}

pub fn gcd(a: i64, b: i64) -> i64 {
    var x = abs(a)
    var y = abs(b)
    for y != 0 {
        t := x % y
        x = y
        y = t
    }
    return x
}

pub fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 { return 0 }
    return abs(a / gcd(a, b) * b)
}
